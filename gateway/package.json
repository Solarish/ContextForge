{
  "name": "contextforge-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild src/report-app.ts --bundle --minify --format=iife --platform=browser --outfile=public/report-app.js",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "mcp": "node dist/mcp-server.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
